generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("CLIENT") // CLIENT | PROVIDER | ADMIN
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  providerProfile    ProviderProfile?
  clientAppointments Appointment[]      @relation("ClientAppointments")
  notifications      Notification[]
  actorEvents        AppointmentEvent[] @relation("ActorEvents")
}

model ProviderProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  title     String
  specialty String
  bio       String  @default("")
  isActive  Boolean @default(true)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          ProviderService[]
  availabilityRules AvailabilityRule[]
  blockedSlots      BlockedSlot[]
  appointments      Appointment[]      @relation("ProviderAppointments")
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  priceCents      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  providers    ProviderService[]
  appointments Appointment[]
}

model ProviderService {
  providerId String
  serviceId  String

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
}

model AvailabilityRule {
  id         String  @id @default(cuid())
  providerId String
  dayOfWeek  Int     // 0 (Sunday) .. 6 (Saturday)
  startTime  String  // HH:mm in provider's timezone
  endTime    String  // HH:mm in provider's timezone
  isEnabled  Boolean @default(true)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
}

model BlockedSlot {
  id         String   @id @default(cuid())
  providerId String
  startUtc   DateTime
  endUtc     DateTime
  reason     String   @default("Unavailable")
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startUtc, endUtc])
}

model Appointment {
  id            String   @id @default(cuid())
  referenceCode String   @unique
  clientId      String
  providerId    String
  serviceId     String
  startUtc      DateTime
  endUtc        DateTime
  status        String   @default("CONFIRMED") // PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
  notes         String   @default("")
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        User               @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  provider      ProviderProfile    @relation("ProviderAppointments", fields: [providerId], references: [id], onDelete: Cascade)
  service       Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events        AppointmentEvent[]
  notifications Notification[]

  @@index([providerId, startUtc, endUtc])
  @@index([clientId, startUtc])
}

model AppointmentEvent {
  id            String   @id @default(cuid())
  appointmentId String
  actorId       String?
  fromStatus    String?
  toStatus      String
  note          String   @default("")
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation("ActorEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appointmentId, createdAt])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?
  type          String   // BOOKING_CONFIRMED | RESCHEDULED | STATUS_UPDATED | CANCELLED
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
}

